{
  "info": {
    "name": "RE'SERV Service Catalogue",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "serviceId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1 - Categories",
      "item": [
        {
          "name": "Creer une categorie (201 - ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coiffure\",\n  \"description\": \"Prestations capillaires et soins\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('categoryId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister toutes les categories (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        },
        {
          "name": "Consulter une categorie par ID (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Modifier une categorie (200 - ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coiffure & Beaute\",\n  \"description\": \"Coupes, brushings et soins capillaires\"\n}"
            }
          }
        },
        {
          "name": "Supprimer une categorie (204 - ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "{{categoryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2 - Services",
      "item": [
        {
          "name": "Creer une prestation (201 - ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coupe de cheveux\",\n  \"description\": \"Coupe et mise en forme\",\n  \"price\": 25.000,\n  \"duration\": 45,\n  \"categoryId\": {{categoryId}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('serviceId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister toutes les prestations (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"]
            }
          }
        },
        {
          "name": "Consulter une prestation par ID (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services", "{{serviceId}}"]
            }
          }
        },
        {
          "name": "Lister les prestations par categorie (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services/category/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services", "category", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Rechercher des prestations par nom (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services/search?name=Coupe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services", "search"],
              "query": [
                { "key": "name", "value": "Coupe" }
              ]
            }
          }
        },
        {
          "name": "Filtrer les prestations par prix (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/services?minPrice=10&maxPrice=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"],
              "query": [
                { "key": "minPrice", "value": "10" },
                { "key": "maxPrice", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Modifier une prestation (200 - ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services", "{{serviceId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coupe de cheveux premium\",\n  \"description\": \"Coupe, shampoing et mise en forme\",\n  \"price\": 30.000,\n  \"duration\": 45,\n  \"categoryId\": {{categoryId}}\n}"
            }
          }
        },
        {
          "name": "Desactiver une prestation (200 - ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/services/{{serviceId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services", "{{serviceId}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Inavailable\"\n}"
            }
          }
        },
        {
          "name": "Reactiver une prestation (200 - ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/services/{{serviceId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services", "{{serviceId}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Available\"\n}"
            }
          }
        },
        {
          "name": "Supprimer une prestation (204 - ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services", "{{serviceId}}"]
            }
          }
        }
      ]
    }
  ]
}
